# کپی کن به .env در ریشه پروژه
APP_NAME=dayan
APP_ENV=development
DEBUG=true

# ---- LLM (LM Studio / OpenAI-compatible) ----
LLM_PROVIDER=lm_studio
MODEL_URL=http://localhost:1234
MODEL_NAME=model
TEMPERATURE=0.3
MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=90
SYSTEM_PROMPT_PATH=ai_model/prompts/system.json
LLM_DISABLE_THINKING=true
LLM_CONTEXT_MAX_CHARS=2500
SYSTEM_PROMPT_MAX_CHARS=2000
PAGE_TEXT_MAX_CHARS=900

# ---- RAG / Embedding ----
RAG_ENABLED=true
RAG_TOP_K=3
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CPU_THREADS=4

# ---- دیتابیس اصلی ----
# اگر خالی بگذاری از POSTGRES_* ساخته می‌شود
DATABASE_URL=postgresql+asyncpg://dayan:dayan_pass@127.0.0.1:5433/dayan_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=dayan_db
POSTGRES_USER=dayan
POSTGRES_PASSWORD=dayan_pass
# اگر Postgres در دسترس نبود، برای توسعه روی SQLite برو
DB_FALLBACK_SQLITE=true

# ---- Mongo (لاگ و حافظه مکالمه) ----
MONGO_URI=mongodb://127.0.0.1:27018
MONGO_DB=dayan_logs
MEMORY_MAX_TURNS=20

# ---- Redis (rate limit / کش / pubsub) ----
# اگر Redis روشن نیست خالی بگذار تا درخواست‌ها گیر نکنند
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Qdrant (سرور Docker برای اشتراک با Temporal worker) ----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_PATH=
QDRANT_COLLECTION=documents

# ---- JWT ----
# در production حتماً یک رشته تصادفی بلند بگذار
JWT_SECRET=change-me-please-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=14

# ---- Rate limit (تعداد در بازه ثانیه‌ای) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_CHAT=30/60
RATE_LIMIT_DEFAULT=120/60

# ---- CORS / مسیرها ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:4000,http://127.0.0.1:4000
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
CMS_PATH=./data/cms/site.json

# ---- Temporal ----
TEMPORAL_HOST=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=dayan-tasks

# ---- Web fallback ----
WEB_CRAWL_ENABLED=true
WEB_BASE_URL=
SEARCH_ENGINE=site_crawl
